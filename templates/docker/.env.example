# ===========================================
# DevLog Docker Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_hex(32))'

# --- Required ---
SECRET_KEY=
ADMIN_PASSWORD=

# --- Admin ---
ADMIN_USERNAME=admin

# --- Session ---
SESSION_COOKIE_SECURE=true

# --- Proxy ---
PROXY_COUNT=1

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Cache ---
# CACHE_REDIS_URL=redis://redis:6379/0

# --- Celery ---
# CELERY_BROKER_URL=redis://redis:6379/0

# --- Scheduler ---
# Set to "true" on exactly ONE container to enable APScheduler
ENABLE_SCHEDULER=false

# --- SMTP / Newsletter (optional) ---
# SMTP_HOST=smtp.example.com
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password

# --- API ---
# API_KEY=your-api-key-here

# --- Health Check ---
# HEALTH_CHECK_SECRET=

# --- Metrics ---
# ENABLE_METRICS=false
# METRICS_SECRET=

# --- Database (optional, defaults to SQLite) ---
# SQLALCHEMY_DATABASE_URI=postgresql://user:pass@localhost/blog

# --- Storage ---
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL=

# --- Webhook Encryption ---
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
# WEBHOOK_ENCRYPTION_KEY=

# --- Backup Encryption ---
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(12))'
# BACKUP_ENCRYPTION_KEY=

# --- Rate Limiting ---
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
