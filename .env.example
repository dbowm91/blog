# ===========================================
# DevLog Environment Configuration
# ===========================================
# Copy this file and fill in values.
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_hex(32))'

# --- Required ---
SECRET_KEY=replace-with-output-of-python-secrets-token-hex-32
ADMIN_PASSWORD=replace-with-generated-password

# --- Admin ---
ADMIN_USERNAME=admin

# --- Session ---
SESSION_COOKIE_SECURE=true

# --- Proxy ---
PROXY_COUNT=1

# --- API ---
# API_KEY=your-api-key-here

# --- Database (optional, defaults to SQLite) ---
# SQLALCHEMY_DATABASE_URI=postgresql://user:pass@localhost/blog

# --- SMTP / Newsletter (optional, leave blank to disable email) ---
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password

# --- Redis (used by Celery and rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Cache ---
CACHE_REDIS_URL=

# --- Celery ---
CELERY_BROKER_URL=

# --- Health Check ---
HEALTH_CHECK_SECRET=

# --- Page View Buffer ---
PAGE_VIEW_BUFFER_SIZE=0
PAGE_VIEW_FLUSH_INTERVAL=5

# --- Storage ---
STORAGE_BACKEND=local
# S3_BUCKET=my-blog-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_PUBLIC_URL=https://my-blog-uploads.s3.amazonaws.com

# --- Webhook Encryption ---
# WEBHOOK_ENCRYPTION_KEY=replace-with-strong-passphrase

# --- Backup Encryption ---
# BACKUP_ENCRYPTION_KEY=replace-with-strong-passphrase

# --- Rate Limiting ---
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1
