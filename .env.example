# ===========================================
# DevLog Environment Configuration
# ===========================================
# Copy this file and fill in values.
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_hex(32))'

# --- Required ---
SECRET_KEY=
ADMIN_PASSWORD=

# --- Admin ---
ADMIN_USERNAME=admin

# --- Session ---
# Set to "false" for local HTTP development, "true" for HTTPS production
SESSION_COOKIE_SECURE=true

# --- Proxy ---
# Number of reverse proxies in front of the app (for ProxyFix middleware)
PROXY_COUNT=1

# --- API ---
# API_KEY=your-api-key-here

# --- Site ---
# CDN_URL=https://cdn.example.com

# --- Database (optional, defaults to SQLite) ---
# PostgreSQL is experimental. See DEPLOY.md § PostgreSQL Migration.
# SQLALCHEMY_DATABASE_URI=postgresql://user:pass@localhost/blog
# DATABASE_URL=postgresql://user:pass@localhost/blog

# --- SMTP / Newsletter (optional, leave blank to disable email) ---
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_TIMEOUT=30

# --- Redis (cache/rate limiting, used by Docker production profile) ---
REDIS_URL=redis://localhost:6379/0

# --- Cache ---
# CACHE_REDIS_URL=redis://localhost:6379/0

# --- Celery ---
# CELERY_BROKER_URL=redis://localhost:6379/0

# --- Scheduler ---
# Set to "true" on ONE container to enable APScheduler (newsletter, backups, etc.)
# ENABLE_SCHEDULER=true

# --- Health Check ---
# Secret for detailed /health?detailed=true endpoint
# HEALTH_CHECK_SECRET=
# Secret for /metrics endpoint (requires explicit secret; no fallback)
# METRICS_SECRET=
# Enable /metrics endpoint (default: false; must be true with METRICS_SECRET in production)
# ENABLE_METRICS=false

# --- Page View Buffer ---
PAGE_VIEW_BUFFER_SIZE=0
PAGE_VIEW_FLUSH_INTERVAL=5

# --- Storage ---
STORAGE_BACKEND=local
# S3_BUCKET=my-blog-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_PUBLIC_URL=https://my-blog-uploads.s3.amazonaws.com

# --- Webhook Encryption ---
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
# WEBHOOK_ENCRYPTION_KEY=replace-with-strong-passphrase

# --- Backup Encryption ---
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(12))'
# BACKUP_ENCRYPTION_KEY=replace-with-strong-passphrase

# --- Rate Limiting ---
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# --- Security ---
# LOGIN_FAILURE_DELAY=0.05
